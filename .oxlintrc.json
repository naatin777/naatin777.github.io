{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "@fontsource*/**"] }]
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["content/**", "static/**", "build/**", "dist/**", ".svelte-kit/**", "output/**"]
}
