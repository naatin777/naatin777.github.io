{
  "name": "naatin777-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pagefind --site build && node scripts/generate-og.ts",
    "preview": "node scripts/serve-build.ts",
    "sync:external-posts": "pnpm sync:zenn && pnpm sync:qiita",
    "sync:zenn": "node scripts/sync-zenn-posts.ts",
    "sync:qiita": "node scripts/sync-qiita-posts.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "validate": "pnpm run check && pnpm run lint && pnpm run format:check && pnpm run test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@lucide/svelte": "^1.47.0",
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-text": "^4.0.2",
    "katex": "^0.18.7",
    "mermaid-isomorphic": "^3.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "simple-icons": "^16.32.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "fast-xml-parser": "^5.11.1",
    "lighthouse": "^13.5.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "cookie@<0.7.0": "0.7.2",
      "tmp@<0.2.6": ">=0.2.6",
      "uuid@<11.1.1": ">=11.1.1",
      "sharp@<0.35.4": ">=0.35.4"
    }
  }
}
